# Server
PORT=3000

# Database (PostgreSQL for Staging/Production, SQLite file for Offline Tests)
# DATABASE_URL="postgres://postgres:postgres@localhost:5432/janebi"
DATABASE_URL=data/janebi.db

# Docker Compose DB password (must match the password inside DATABASE_URL above)
POSTGRES_PASSWORD=postgres

# Authentication
JWT_ACCESS_SECRET="generate-a-strong-secret-key-here-for-access"
JWT_REFRESH_SECRET="generate-a-strong-secret-key-here-for-refresh"

# Payment (ZarinPal)
ZARINPAL_MERCHANT_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
ZARINPAL_SANDBOX=true

# AI (Optional)
GEMINI_API_KEY=""

# App URL
APP_URL="http://localhost:3000"

# CORS (comma-separated list of allowed origins; defaults to APP_URL + localhost dev ports)
# CORS_ORIGIN="https://janebiarena.ir,https://www.janebiarena.ir"
# SMS (optional). Leave SMS_API_KEY empty to keep OTP gracefully disabled.
# SMS_TEMPLATE_ID must be a real SMS.ir verify template ID ('123456' is the
# docs placeholder and is treated as not-configured).
SMS_API_KEY=
SMS_PROVIDER=sms.ir
# SMS_TEMPLATE_ID=
