{
  "$description": "Janebi Arena Design Tokens — DDS-inspired (Digikala Design System #ef4056) adapted to rose brand #e11d48. Single source of truth. index.css @theme mirrors this file. Edit HERE first, then mirror to index.css.",
  "color": {
    "brand": {
      "50": "#fff1f2",
      "100": "#ffe4e6",
      "200": "#fecdd3",
      "300": "#fda4af",
      "400": "#fb7185",
      "500": "#f43f5e",
      "600": "#e11d48",
      "700": "#be123c",
      "800": "#9f1239",
      "900": "#881337",
      "950": "#4c0519"
    },
    "semantic": {
      "cta": {
        "default": "#e11d48",
        "hover": "#be123c",
        "active": "#9f1239"
      },
      "success": "#10b981",
      "warning": "#f59e0b",
      "info": "#3b82f6",
      "error": "#dc2626"
    },
    "surface": {
      "light": {
        "canvas": "#f1f5f9",
        "header": "#ffffff",
        "card": "#ffffff",
        "elevated": "#ffffff",
        "footer": "#f8fafc",
        "topbar": "#f1f5f9"
      },
      "dark": {
        "canvas": "#090d16",
        "header": "#0c1220",
        "topbar": "#060910",
        "card": "#0e1629",
        "elevated": "#121c33",
        "footer": "#070b14",
        "bottomnav": "#0c1220"
      }
    },
    "text": {
      "light": {
        "main": "#0f172a",
        "muted": "#475569",
        "subtle": "#64748b"
      },
      "dark": {
        "main": "#f8fafc",
        "muted": "#94a3b8",
        "subtle": "#64748b"
      }
    },
    "border": {
      "light": "rgba(15, 23, 42, 0.09)",
      "dark": "rgba(255, 255, 255, 0.08)",
      "lightHover": "rgba(225, 29, 72, 0.35)",
      "darkHover": "rgba(225, 29, 72, 0.45)"
    }
  },
  "typography": {
    "fontFamily": {
      "sans": "Vazirmatn, system-ui, -apple-system, sans-serif",
      "mono": "monospace"
    },
    "fontSize": {
      "display": { "value": "3rem", "lineHeight": "1.15", "weight": "900" },
      "h1": { "value": "2.25rem", "lineHeight": "1.15", "weight": "900" },
      "h2": { "value": "1.5rem", "lineHeight": "1.2", "weight": "900" },
      "h3": { "value": "1.125rem", "lineHeight": "1.3", "weight": "900" },
      "body": { "value": "1rem", "lineHeight": "1.6", "weight": "400" },
      "small": { "value": "0.875rem", "lineHeight": "1.5", "weight": "700" },
      "micro": { "value": "0.75rem", "lineHeight": "1.4", "weight": "700" }
    }
  },
  "spacing": {
    "unit": "4px",
    "section": { "sm": "2rem", "md": "3rem", "lg": "3rem" },
    "cardPadding": { "mobile": "0.75rem", "desktop": "1rem" },
    "containerMax": "1280px",
    "containerPadding": { "mobile": "12px", "tablet": "24px", "desktop": "32px" }
  },
  "radius": {
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "20px",
    "card": "16px",
    "button": "12px",
    "pill": "9999px",
    "hero": "24px"
  },
  "shadow": {
    "elevation1": "0 4px 20px rgba(11, 21, 54, 0.04)",
    "elevation2": "0 4px 20px rgba(11, 21, 54, 0.07), 0 2px 6px -2px rgba(11, 21, 54, 0.05)",
    "elevation3": "0 10px 15px -3px rgba(11, 21, 54, 0.08), 0 4px 6px -4px rgba(11, 21, 54, 0.04)",
    "cta": "0 8px 24px -4px rgba(225, 29, 72, 0.35)",
    "bottomnav": {
      "light": "0 -4px 20px rgba(0,0,0,0.06)",
      "dark": "0 -4px 20px rgba(0,0,0,0.4)"
    }
  },
  "motion": {
    "duration": { "fast": "150ms", "base": "200ms", "slow": "500ms" },
    "easing": "cubic-bezier(0.16, 1, 0.3, 1)"
  },
  "zIndex": {
    "header": "40",
    "bottomnav": "40",
    "drawer": "50",
    "modal": "50",
    "toast": "60",
    "chat": "45"
  }
}
